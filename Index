<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Petualangan Misi Belajar: Uang dan Bank</title>
<style>
:root{--ink:#10282e;--deep:#0b3d4a;--sea:#1e8a8a;--mint:#d9f2e6;--gold:#f5b82e;--coral:#ef6f5e;--paper:#fffdf5;--ok:#1f9d63;--bad:#d64545}
*{box-sizing:border-box;margin:0}
html,body{min-height:100%}
body{font-family:"Trebuchet MS","Segoe UI",system-ui,sans-serif;color:var(--ink);background:linear-gradient(180deg,#0b3d4a,#126a73 60%,#1e8a8a);background-attachment:fixed}
#top{position:sticky;top:0;z-index:20;display:flex;gap:10px;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(7,36,43,.92);color:#fff;font-weight:700}
#top .t{font-size:15px}
.chip{background:rgba(255,255,255,.14);padding:5px 11px;border-radius:99px;font-size:14px;white-space:nowrap}
#snd{cursor:pointer;border:0;color:#fff;font-size:16px}
main{max-width:760px;margin:0 auto;padding:16px}
.card{background:var(--paper);border-radius:22px;padding:22px;box-shadow:0 10px 0 rgba(0,0,0,.18)}
h1{font-size:clamp(28px,7vw,44px);line-height:1.08;color:var(--deep)}
h2{font-size:clamp(21px,5vw,28px);color:var(--deep);margin-bottom:8px}
p{line-height:1.55}
.btn{font:inherit;font-weight:800;font-size:17px;border:0;border-radius:16px;padding:13px 22px;background:var(--gold);color:#3a2a00;cursor:pointer;box-shadow:0 5px 0 #b98410;transition:transform .08s,box-shadow .08s}
.btn:hover{transform:translateY(-1px)}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 #b98410}
.btn.alt{background:#fff;color:var(--deep);box-shadow:0 5px 0 #b9c9c9}
.btn.sm{font-size:14px;padding:8px 14px;box-shadow:0 3px 0 #b98410}
.btn:focus-visible,.opt:focus-visible,input:focus-visible,#snd:focus-visible{outline:4px solid var(--coral);outline-offset:2px}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.hero{text-align:center}
.coin{font-size:72px;display:inline-block;animation:spin 3s ease-in-out infinite}
@keyframes spin{0%,100%{transform:rotateY(0)}50%{transform:rotateY(360deg)}}
.map{position:relative;height:min(78vh,560px);border-radius:22px;overflow:hidden;background:radial-gradient(circle at 20% 90%,#7bd3a0 0 14%,transparent 15%),radial-gradient(circle at 80% 60%,#9ddcb0 0 16%,transparent 17%),radial-gradient(circle at 30% 35%,#82d4a4 0 14%,transparent 15%),radial-gradient(circle at 70% 15%,#b9e6bf 0 14%,transparent 15%),#8fd0e0;box-shadow:0 10px 0 rgba(0,0,0,.18)}
.map svg{position:absolute;inset:0;width:100%;height:100%}
.fog{position:absolute;left:0;right:0;top:0;z-index:1;background:linear-gradient(180deg,#0b3d4a 70%,rgba(11,61,74,.0));display:flex;align-items:flex-start;justify-content:center;color:#cfe9ea;font-weight:700;padding-top:14px;transition:height 1.4s ease}
.node{position:absolute;z-index:2;transform:translate(-50%,-50%);width:88px;text-align:center;border:0;background:none;font:inherit;cursor:pointer}
.node .b{display:grid;place-items:center;width:62px;height:62px;margin:0 auto;border-radius:50%;background:var(--gold);font-size:30px;border:4px solid #fff;box-shadow:0 5px 0 #b98410}
.node.cur .b{animation:pulse 1.2s infinite}
.node.lock{cursor:not-allowed}.node.lock .b{background:#5b7a80;box-shadow:0 5px 0 #3d5459}
.node.done .b{background:var(--ok);box-shadow:0 5px 0 #146b43}
.node small{display:block;margin-top:4px;font-weight:800;font-size:12px;background:rgba(255,255,255,.9);border-radius:8px;padding:2px 4px;line-height:1.2}
@keyframes pulse{50%{transform:scale(1.14)}}
.bar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px;font-weight:800}
.dots{display:flex;gap:6px}.dots i{width:30px;height:9px;border-radius:9px;background:#d4dede}.dots i.on{background:var(--gold)}.dots i.ok{background:var(--ok)}.dots i.no{background:var(--bad)}
.q{font-size:clamp(18px,4.5vw,23px);font-weight:800;line-height:1.35;margin:6px 0 16px}
.tag{display:inline-block;font-size:13px;font-weight:800;background:var(--mint);color:var(--deep);padding:3px 10px;border-radius:99px}
.opts{display:grid;gap:10px}
.opt{font:inherit;font-weight:700;font-size:16px;text-align:left;padding:14px 16px;border-radius:14px;border:3px solid #d4dede;background:#fff;cursor:pointer;color:var(--ink);transition:transform .1s,border-color .1s}
.opt:hover:not(:disabled){border-color:var(--sea);transform:translateX(3px)}
.opt.ok{background:#d8f5e5;border-color:var(--ok)}
.opt.bad{background:#fde1e1;border-color:var(--bad);animation:shake .35s}
.opt.off{opacity:.35;text-decoration:line-through}
.opt:disabled{cursor:default}
.tf{grid-template-columns:1fr 1fr}.tf .opt{text-align:center;font-size:18px}
input[type=text]{width:100%;font:inherit;font-size:18px;font-weight:700;padding:13px 14px;border-radius:14px;border:3px solid #d4dede;margin-bottom:10px}
@keyframes shake{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.hint,.fb{margin-top:14px;padding:13px 15px;border-radius:14px;line-height:1.5;animation:slide .3s}
.hint{background:#fff3c9;border:2px dashed var(--gold)}
.fb.ok{background:#d8f5e5;border-left:8px solid var(--ok)}.fb.bad{background:#fde1e1;border-left:8px solid var(--bad)}
@keyframes slide{from{opacity:0;transform:translateY(8px)}}
.stars{font-size:46px;letter-spacing:6px}
.stars span{display:inline-block;opacity:0;animation:pop .6s forwards}
.stars span:nth-child(2){animation-delay:.35s}.stars span:nth-child(3){animation-delay:.7s}
@keyframes pop{0%{opacity:0;transform:scale(0) rotate(-90deg)}70%{transform:scale(1.4) rotate(10deg)}100%{opacity:1;transform:scale(1)}}
.center{text-align:center}.center .row{justify-content:center}
.big{font-size:42px;font-weight:900;color:var(--deep)}
.fly{position:fixed;top:-20px;z-index:50;pointer-events:none;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg)}}
.float{position:fixed;z-index:50;left:50%;top:40%;font-size:32px;font-weight:900;color:var(--gold);text-shadow:0 2px 0 #000;animation:up 1s forwards;pointer-events:none}
@keyframes up{to{transform:translate(-50%,-90px);opacity:0}}
@media(max-width:480px){.tf{grid-template-columns:1fr}.node{width:74px}.node .b{width:52px;height:52px;font-size:24px}.card{padding:16px}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01s!important;animation-iteration-count:1!important;transition:none!important}}
</style>
</head>
<body>
<div id="top"><span class="t">🗺️ Misi Belajar: Uang dan Bank</span><span><span class="chip" id="sc">⭐ 0 poin</span> <button class="chip" id="snd" aria-label="Suara">🔊</button></span></div>
<main id="app"></main>
<script>
var LV=[
{n:"Hutan Barter",e:"🌲",intro:"Kamu tiba di hutan tempat penduduk masih bertukar barang. Jawab misi untuk membuka jalan!",q:[
{t:"mc",q:"Sistem tukar-menukar barang dengan barang secara langsung tanpa uang disebut ....",o:["Barter","Kredit","Deposito","Inflasi"],a:0,h:"Zaman dulu orang menukar beras dengan ikan.",x:"Barter adalah tukar barang dengan barang. Kelemahannya: sulit menemukan pihak yang keinginannya cocok dan sulit menentukan nilai tukar."},
{t:"mc",q:"Harga sepotong roti Rp5.000 dan sepatu Rp200.000. Hal ini menunjukkan fungsi uang sebagai ....",o:["Alat tukar","Satuan hitung","Alat pembayaran utang","Penimbun kekayaan"],a:1,h:"Uang dipakai untuk mengukur dan membandingkan nilai barang.",x:"Satuan hitung (ukuran nilai) berarti uang dipakai untuk menyatakan harga dan membandingkan nilai barang atau jasa."},
{t:"tf",q:"Syarat uang yang baik antara lain diterima umum dan nilainya relatif stabil.",a:true,h:"Orang harus mau menerimanya, dan nilainya jangan naik turun drastis.",x:"Benar. Syarat uang: diterima umum, nilai stabil, tahan lama, mudah dibawa, mudah dibagi, sulit dipalsukan."},
{t:"fill",q:"Uang yang berupa kertas dan logam, diterbitkan Bank Indonesia, disebut uang ....",a:["kartal"],h:"Berawalan huruf K. Lawannya adalah uang giral.",x:"Uang kartal adalah uang kertas dan logam yang dipakai sebagai alat pembayaran sah."}]},
{n:"Lembah Uang",e:"🪙",intro:"Di lembah ini tersimpan koin dan lembaran dengan berbagai nilai. Kenali jenis dan nilainya!",q:[
{t:"mc",q:"Nilai yang tertera atau tertulis pada uang disebut nilai ....",o:["Intrinsik","Nominal","Riil","Subjektif"],a:1,h:"Contoh: angka 50.000 pada selembar uang.",x:"Nilai nominal adalah nilai yang tertulis pada uang. Nilai intrinsik adalah nilai bahan pembuatnya."},
{t:"tf",q:"Pada uang kertas modern, nilai intrinsiknya jauh lebih tinggi daripada nilai nominalnya.",a:false,h:"Bandingkan harga selembar kertas dengan angka yang tercetak.",x:"Salah. Nilai bahan kertasnya sangat kecil dibanding nilai nominalnya. Itulah sebabnya uang dipercaya karena dijamin negara."},
{t:"mc",q:"Manakah yang termasuk uang giral?",o:["Koin Rp1.000","Uang kertas Rp50.000","Cek","Uang saku anak"],a:2,h:"Uang giral ada di rekening bank dan dipakai lewat surat berharga.",x:"Uang giral adalah simpanan di bank yang bisa ditarik atau dipindahkan dengan cek atau bilyet giro."},
{t:"mc",q:"Saldo dompet digital dan kartu tol prabayar termasuk ....",o:["Uang logam","Uang elektronik","Barter","Uang intrinsik"],a:1,h:"Nilai uangnya disimpan secara digital pada media elektronik.",x:"Uang elektronik adalah alat pembayaran dengan nilai uang yang disimpan pada media elektronik seperti server atau chip."}]},
{n:"Kota Bank",e:"🏦",intro:"Selamat datang di Kota Bank! Pelajari lembaga yang mengelola dan mengawasi uang.",q:[
{t:"mc",q:"Bank sentral di Indonesia yang bertugas menjaga kestabilan nilai rupiah adalah ....",o:["Bank Rakyat Indonesia","Otoritas Jasa Keuangan","Bank Indonesia","Bank Mandiri"],a:2,h:"Satu-satunya yang berhak mengedarkan rupiah.",x:"Bank Indonesia adalah bank sentral. Tugasnya: menetapkan kebijakan moneter, menjaga nilai rupiah, dan mengatur sistem pembayaran."},
{t:"tf",q:"Bank Perkreditan Rakyat (BPR) boleh menerima simpanan giro.",a:false,h:"BPR memiliki kegiatan lebih terbatas dibanding bank umum.",x:"Salah. BPR tidak boleh menerima giro dan tidak ikut lalu lintas pembayaran. BPR menerima tabungan dan deposito."},
{t:"mc",q:"Lembaga independen yang mengawasi bank dan lembaga jasa keuangan lainnya adalah ....",o:["OJK","BUMN","BPS","LPS"],a:0,h:"Singkatan dari Otoritas Jasa Keuangan.",x:"OJK mengatur dan mengawasi sektor jasa keuangan. LPS bertugas menjamin simpanan nasabah."},
{t:"fill",q:"Bank Perkreditan ...., melayani masyarakat kecil di kecamatan atau desa (singkatan BPR).",a:["rakyat"],h:"Kata ini juga ada pada nama bank BRI.",x:"BPR = Bank Perkreditan Rakyat, bank yang melayani usaha kecil dan masyarakat daerah."}]},
{n:"Pulau Tabungan",e:"🐷",intro:"Di pulau ini kamu belajar produk bank dan menghitung bunganya. Siapkan kalkulatormu di kepala!",q:[
{t:"mc",q:"Simpanan di bank yang hanya bisa dicairkan setelah jangka waktu tertentu adalah ....",o:["Tabungan","Giro","Deposito","Rekening koran"],a:2,h:"Misalnya jangka waktu 3, 6, atau 12 bulan.",x:"Deposito dicairkan sesuai jangka waktu. Biasanya bunganya lebih tinggi dari tabungan."},
{t:"tf",q:"Bunga adalah balas jasa yang diberikan bank kepada nasabah penyimpan dana.",a:true,h:"Bank memakai dana nasabah untuk dikreditkan.",x:"Benar. Bank membayar bunga simpanan kepada penabung dan menerima bunga kredit dari peminjam."},
{t:"mc",q:"Rina menabung Rp2.000.000 dengan bunga 6% per tahun. Bunga setelah 1 tahun adalah ....",o:["Rp60.000","Rp120.000","Rp200.000","Rp12.000"],a:1,h:"Hitung 6% x 2.000.000.",x:"Bunga = 6/100 x 2.000.000 = Rp120.000."},
{t:"fill",q:"Modal Rp1.000.000 dengan bunga 12% per tahun. Berapa rupiah bunga selama 6 bulan? (ketik angkanya)",a:["60000"],h:"Bunga setahun Rp120.000. Enam bulan adalah setengah tahun.",x:"Bunga = 12% x 1.000.000 x 6/12 = Rp60.000."}]},
{n:"Gunung Inflasi",e:"🌋",intro:"Puncak terakhir! Hadapi inflasi dan kebijakan moneter untuk menjadi juara.",q:[
{t:"mc",q:"Kenaikan harga barang dan jasa secara umum dan terus-menerus disebut ....",o:["Deflasi","Devaluasi","Inflasi","Depresiasi"],a:2,h:"Akibatnya daya beli uang menurun.",x:"Inflasi membuat nilai uang turun, sehingga uang yang sama membeli barang lebih sedikit."},
{t:"mc",q:"Saat inflasi tinggi, langkah kebijakan moneter Bank Indonesia yang tepat adalah ....",o:["Menurunkan suku bunga","Menaikkan suku bunga acuan","Mencetak uang sebanyak-banyaknya","Menghapus pajak"],a:1,h:"Tujuannya mengurangi jumlah uang beredar.",x:"Menaikkan suku bunga mendorong orang menabung dan mengurangi uang beredar, sehingga tekanan inflasi turun."},
{t:"tf",q:"Mencetak uang sebanyak-banyaknya adalah cara terbaik mengatasi kemiskinan tanpa efek samping.",a:false,h:"Uang banyak tetapi barang tetap sedikit, apa yang terjadi pada harga?",x:"Salah. Uang berlebih tanpa tambahan barang justru memicu inflasi, bahkan hiperinflasi."},
{t:"fill",q:"QRIS adalah singkatan dari Quick Response Code Indonesian ....",a:["standard"],h:"Berawalan huruf S, artinya 'baku'.",x:"QRIS = Quick Response Code Indonesian Standard, standar kode QR pembayaran nasional dari Bank Indonesia."}]}
];
var POS=[[16,84],[72,70],[26,52],[72,34],[46,13]];
var S={best:[0,0,0,0,0],stars:[0,0,0,0,0],unl:1,lv:0,qi:0,hearts:3,streak:0,hint:false,done:false,ls:0,res:[],snd:true};
var $=function(i){return document.getElementById(i)},app=$("app"),AC=null;
function total(){return S.best.reduce(function(a,b){return a+b},0)}
function head(){$("sc").textContent="⭐ "+total()+" poin"}
function beep(f,d,ty){if(!S.snd)return;try{AC=AC||new(window.AudioContext||window.webkitAudioContext)();var o=AC.createOscillator(),g=AC.createGain();o.type=ty||"sine";o.frequency.value=f;g.gain.value=.08;o.connect(g);g.connect(AC.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,AC.currentTime+d);o.stop(AC.currentTime+d)}catch(e){}}
function jingle(a){a.forEach(function(f,i){setTimeout(function(){beep(f,.22,"triangle")},i*130)})}
$("snd").onclick=function(){S.snd=!S.snd;this.textContent=S.snd?"🔊":"🔇"};
function confetti(n){var c=["🪙","⭐","🎉","✨","💰"];for(var i=0;i<(n||40);i++){var s=document.createElement("span");s.className="fly";s.textContent=c[i%5];s.style.left=Math.random()*100+"vw";s.style.fontSize=16+Math.random()*22+"px";s.style.animationDuration=2+Math.random()*2.5+"s";s.style.animationDelay=Math.random()*.8+"s";document.body.appendChild(s);setTimeout(function(x){x.remove()},5500,s)}}
function floatTxt(t){var d=document.createElement("div");d.className="float";d.textContent=t;document.body.appendChild(d);setTimeout(function(){d.remove()},1000)}
function norm(s){return String(s).toLowerCase().replace(/rp|[.,\s]/g,"")}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;")}
function save(){try{localStorage.setItem("misiUangBank",JSON.stringify({best:S.best,stars:S.stars,unl:S.unl}))}catch(e){}}
function load(){try{var d=JSON.parse(localStorage.getItem("misiUangBank"));if(d&&d.best&&d.best.length==5){S.best=d.best;S.stars=d.stars;S.unl=d.unl}}catch(e){}}
function home(){
var has=S.unl>1||total()>0;
app.innerHTML='<div class="card hero"><div class="coin">🪙</div><h1>Petualangan Misi Belajar</h1><p style="margin:10px 0"><b>IPS Kelas 9 · Uang dan Bank</b></p><p>Jawab tantangan soal untuk membuka peta, kumpulkan bintang, dan taklukkan 5 level sampai ke puncak Gunung Inflasi.</p><div class="row" style="justify-content:center"><button class="btn" id="go">'+(has?"Lanjutkan petualangan":"Mulai petualangan")+'</button>'+(has?'<button class="btn alt" id="rs">Mulai dari awal</button>':'')+'</div><p style="margin-top:16px;font-size:14px;color:#456">3 nyawa tiap level · Petunjuk mengurangi poin · Streak benar beruntun memberi bonus</p></div>';
$("go").onclick=function(){beep(660,.15);map()};
if($("rs"))$("rs").onclick=function(){if(confirm("Hapus semua progres dan mulai dari awal?")){S.best=[0,0,0,0,0];S.stars=[0,0,0,0,0];S.unl=1;save();head();home()}}}
function map(){
head();var cur=Math.min(S.unl,5)-1,fog=Math.max(0,POS[cur][1]-14);
var h='<div class="bar" style="color:#fff"><span>Peta Petualangan</span><span class="chip">🌟 '+S.stars.reduce(function(a,b){return a+b},0)+' / 15</span></div><div class="map"><svg viewBox="0 0 100 100" preserveAspectRatio="none"><polyline points="'+POS.map(function(p){return p.join(",")}).join(" ")+'" fill="none" stroke="#fff" stroke-width="3" stroke-dasharray="3 3" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-width:5px;opacity:.85"/></svg><div class="fog" style="height:0" data-h="'+fog+'">'+(fog>0?"☁️ Wilayah belum terbuka":"")+'</div>';
LV.forEach(function(l,i){var lock=i>=S.unl,done=S.stars[i]>0,c=lock?"lock":(done?"done":"cur");
h+='<button class="node '+c+'" data-i="'+i+'" style="left:'+POS[i][0]+'%;top:'+POS[i][1]+'%" aria-label="Level '+(i+1)+' '+l.n+(lock?' terkunci':'')+'"><span class="b">'+(lock?"🔒":l.e)+'</span><small>'+(i+1)+'. '+l.n+'<br>'+(done?"★".repeat(S.stars[i])+"☆".repeat(3-S.stars[i]):(lock?"Terkunci":"Mulai!"))+'</small></button>'});
h+='</div><div class="row" style="justify-content:center"><button class="btn alt" id="hm">Menu utama</button></div>';
app.innerHTML=h;
setTimeout(function(){var f=document.querySelector(".fog");if(f)f.style.height=f.dataset.h+"%"},60);
document.querySelectorAll(".node").forEach(function(n){n.onclick=function(){var i=+n.dataset.i;if(i>=S.unl){beep(180,.2,"square");floatTxt("🔒 Selesaikan level sebelumnya");return}intro(i)}});
$("hm").onclick=home}
function intro(i){
app.innerHTML='<div class="card center"><div class="coin">'+LV[i].e+'</div><h2>Level '+(i+1)+': '+LV[i].n+'</h2><p>'+LV[i].intro+'</p><p style="margin-top:8px"><b>4 soal · 3 nyawa ❤️❤️❤️</b></p><div class="row"><button class="btn" id="st">Mulai misi</button><button class="btn alt" id="bk">Kembali ke peta</button></div></div>';
$("st").onclick=function(){S.lv=i;S.qi=0;S.hearts=3;S.streak=0;S.ls=0;S.res=[];quiz()};$("bk").onclick=map}
function quiz(){
var l=LV[S.lv],q=l.q[S.qi];S.hint=false;S.done=false;
var dots=l.q.map(function(_,i){return'<i class="'+(i<S.res.length?(S.res[i]?"ok":"no"):(i==S.qi?"on":""))+'"></i>'}).join("");
var body="";
if(q.t=="mc")body='<div class="opts">'+q.o.map(function(o,i){return'<button class="opt" data-i="'+i+'">'+String.fromCharCode(65+i)+'. '+esc(o)+'</button>'}).join("")+'</div>';
if(q.t=="tf")body='<div class="opts tf"><button class="opt" data-v="1">✅ Benar</button><button class="opt" data-v="0">❌ Salah</button></div>';
if(q.t=="fill")body='<input type="text" id="in" autocomplete="off" placeholder="Ketik jawabanmu..." aria-label="Jawaban"><button class="btn" id="ck">Periksa jawaban</button>';
app.innerHTML='<div class="card"><div class="bar"><span>'+l.e+' Level '+(S.lv+1)+'</span><span id="hr">'+"❤️".repeat(S.hearts)+"🖤".repeat(3-S.hearts)+'</span></div><div class="dots">'+dots+'</div><div style="margin-top:14px"><span class="tag">'+({mc:"Pilihan ganda",tf:"Benar atau salah",fill:"Isian singkat"})[q.t]+'</span></div><div class="q">'+esc(q.q)+'</div>'+body+'<div id="ex"></div><div class="row"><button class="btn sm alt" id="hn">💡 Petunjuk (−50 poin)</button></div></div>';
document.querySelectorAll(".opt").forEach(function(b){b.onclick=function(){answer(q.t=="mc"?+b.dataset.i:b.dataset.v=="1",b)}});
if(q.t=="fill"){$("ck").onclick=function(){var v=$("in").value;if(!v.trim()){floatTxt("Isi dulu ya");return}answer(v)};$("in").onkeydown=function(e){if(e.key=="Enter")$("ck").click()};$("in").focus()}
$("hn").onclick=function(){if(S.done||S.hint)return;S.hint=true;this.disabled=true;
if(q.t=="mc"){var w=[];q.o.forEach(function(_,i){if(i!=q.a)w.push(i)});var k=w[Math.floor(Math.random()*w.length)];var b=document.querySelector('.opt[data-i="'+k+'"]');b.classList.add("off");b.disabled=true}
$("ex").innerHTML='<div class="hint">💡 <b>Petunjuk:</b> '+esc(q.h)+'</div>';beep(520,.15)}}
function answer(v,btn){
if(S.done)return;S.done=true;var q=LV[S.lv].q[S.qi],ok;
ok=q.t=="fill"?q.a.map(norm).indexOf(norm(v))>-1:v===q.a;
document.querySelectorAll(".opt").forEach(function(b){b.disabled=true});
if(q.t=="mc"){document.querySelector('.opt[data-i="'+q.a+'"]').classList.add("ok")}
if(q.t=="tf"){document.querySelector('.opt[data-v="'+(q.a?1:0)+'"]').classList.add("ok")}
if(btn&&!ok)btn.classList.add("bad");
if(q.t=="fill"){$("in").disabled=true;$("ck").style.display="none"}
$("hn").style.display="none";
var msg;
if(ok){S.streak++;var g=(S.hint?50:100)+Math.min(S.streak-1,3)*20;S.ls+=g;S.res.push(true);msg='🎉 <b>Benar! +'+g+' poin</b>'+(S.streak>1?' (streak '+S.streak+'🔥)':'');floatTxt("+"+g);jingle([660,880]);}
else{S.streak=0;S.hearts--;S.res.push(false);msg='😅 <b>Belum tepat.</b>'+(q.t=="fill"?' Jawaban: <b>'+esc(q.a[0])+'</b>.':'');beep(160,.35,"sawtooth");$("hr").textContent="❤️".repeat(S.hearts)+"🖤".repeat(3-S.hearts)}
var last=S.qi==3,fail=S.hearts<=0;
$("ex").innerHTML='<div class="fb '+(ok?"ok":"bad")+'">'+msg+'<br><b>Pembahasan:</b> '+esc(q.x)+'</div><div class="row"><button class="btn" id="nx">'+((last||fail)?"Lihat hasil":"Soal berikutnya")+'</button></div>';
$("nx").focus();
$("nx").onclick=function(){if(fail)return result(false);if(last)return result(true);S.qi++;quiz()}}
function result(win){
var i=S.lv,st=Math.max(1,S.hearts);
if(!win){
app.innerHTML='<div class="card center"><div class="coin">😵</div><h2>Misi belum berhasil</h2><p>Nyawamu habis. Baca lagi pembahasannya, lalu coba lagi. Kamu pasti bisa!</p><div class="row"><button class="btn" id="rt">Ulangi level</button><button class="btn alt" id="bk">Kembali ke peta</button></div></div>';
$("rt").onclick=function(){intro(i)};$("bk").onclick=map;return}
if(S.ls>S.best[i])S.best[i]=S.ls;
if(st>S.stars[i])S.stars[i]=st;
var nw=i+2>S.unl&&i<4;if(nw)S.unl=i+2;save();head();confetti(36);jingle([523,659,784,1046]);
app.innerHTML='<div class="card center"><h2>Level '+(i+1)+' selesai! '+LV[i].e+'</h2><div class="stars" aria-label="'+st+' bintang">'+"<span>⭐</span>".repeat(st)+"<span style='filter:grayscale(1);opacity:.3'>⭐</span>".repeat(0)+'</div><p style="margin-top:10px">Poin level ini: <b>'+S.ls+'</b><br>Total poin: <b>'+total()+'</b></p>'+(nw?'<p style="margin-top:8px">🗺️ <b>Wilayah baru terbuka di peta!</b></p>':'')+'<div class="row">'+(i<4?'<button class="btn" id="nl">Lanjut ke peta</button>':'<button class="btn" id="nl">Lihat kemenangan 🏆</button>')+'<button class="btn alt" id="rp">Main ulang level</button></div></div>';
$("nl").onclick=function(){i<4?map():victory()};$("rp").onclick=function(){intro(i)}}
function victory(){
var s=S.stars.reduce(function(a,b){return a+b},0),r=s>=13?"Gubernur Bank Sentral 👑":s>=9?"Ekonom Handal 💼":"Penabung Cerdas 🐷";
confetti(70);jingle([523,659,784,1046,1319]);setTimeout(function(){confetti(50)},1800);
app.innerHTML='<div class="card center"><div class="coin">🏆</div><h1>Misi Selesai!</h1><p style="margin:8px 0">Kamu menaklukkan Gunung Inflasi dan membuka seluruh peta.</p><div class="big">'+total()+' poin</div><p style="margin:6px 0">🌟 '+s+' dari 15 bintang</p><p>Gelarmu: <b>'+r+'</b></p><div class="row"><button class="btn" id="mp">Lihat peta</button><button class="btn alt" id="ag">Main lagi dari awal</button></div></div>';
$("mp").onclick=map;$("ag").onclick=function(){S.best=[0,0,0,0,0];S.stars=[0,0,0,0,0];S.unl=1;save();head();home()}}
load();head();home();
</script>
